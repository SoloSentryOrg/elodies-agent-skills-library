{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.solosentry.example/m365-handoff/v1/word-content.schema.json",
  "title": "Semantic Word content payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "locale", "title", "purpose", "audience", "sections"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "locale": {"const": "en-GB"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "audience": {"type": "string", "minLength": 1, "maxLength": 300},
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "slot_id", "heading", "heading_level", "blocks"],
        "properties": {
          "section_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "slot_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "heading": {"type": "string", "minLength": 1, "maxLength": 200},
          "heading_level": {"type": "integer", "minimum": 1, "maximum": 3},
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {"$ref": "#/$defs/block"}
          }
        }
      }
    }
  },
  "$defs": {
    "source_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["block_id", "type", "text", "source_ids"],
          "properties": {
            "block_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
            "type": {"enum": ["paragraph", "callout"]},
            "text": {"type": "string", "minLength": 1, "maxLength": 10000},
            "source_ids": {"$ref": "#/$defs/source_ids"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["block_id", "type", "ordered", "items", "source_ids"],
          "properties": {
            "block_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
            "type": {"const": "list"},
            "ordered": {"type": "boolean"},
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {"type": "string", "minLength": 1, "maxLength": 2000}
            },
            "source_ids": {"$ref": "#/$defs/source_ids"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["block_id", "type", "caption", "headers", "rows", "source_ids"],
          "properties": {
            "block_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
            "type": {"const": "table"},
            "caption": {"type": "string", "minLength": 1, "maxLength": 300},
            "headers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {"type": "string", "minLength": 1, "maxLength": 200}
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {"type": "string", "maxLength": 2000}
              }
            },
            "source_ids": {"$ref": "#/$defs/source_ids"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["block_id", "type", "caption", "alt_text", "asset_path", "source_ids"],
          "properties": {
            "block_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
            "type": {"const": "figure"},
            "caption": {"type": "string", "minLength": 1, "maxLength": 300},
            "alt_text": {"type": "string", "minLength": 1, "maxLength": 1000},
            "asset_path": {"type": "string", "pattern": "^assets/[A-Za-z0-9._/-]+$"},
            "source_ids": {"$ref": "#/$defs/source_ids"}
          }
        }
      ]
    }
  }
}
