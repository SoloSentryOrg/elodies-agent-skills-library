{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.solosentry.example/m365-handoff/v1/job.schema.json",
  "title": "Microsoft 365 Copilot handoff job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "environment",
    "request_summary",
    "classification",
    "locale",
    "destination",
    "trusted_instructions",
    "artifacts",
    "source_register"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "environment": {"enum": ["synthetic-test", "production"]},
    "request_summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "classification": {"const": "internal"},
    "locale": {"const": "en-GB"},
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "logical_location"],
      "properties": {
        "kind": {"enum": ["sharepoint", "onedrive"]},
        "logical_location": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        }
      }
    },
    "trusted_instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "require_human_approval_before_replace",
        "allow_external_publication",
        "allow_macros"
      ],
      "properties": {
        "operation": {"const": "create"},
        "require_human_approval_before_replace": {"const": true},
        "allow_external_publication": {"const": false},
        "allow_macros": {"const": false}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "kind",
          "payload",
          "output_filename",
          "template_profile_id",
          "template_version",
          "template_sha256"
        ],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "kind": {"const": "word"},
          "payload": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+[.]json$"},
          "output_filename": {
            "type": "string",
            "pattern": "^[^/\\\\]{1,120}[.]docx$"
          },
          "template_profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "template_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"},
          "template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "source_register": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+[.]json$"}
  }
}
