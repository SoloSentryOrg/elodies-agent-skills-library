{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.solosentry.example/m365-handoff/v1/template-profile.schema.json",
  "title": "Template profile registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "profiles"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_file_count", "max_individual_file_bytes", "max_total_package_bytes"],
      "properties": {
        "max_file_count": {"type": "integer", "minimum": 8, "maximum": 512},
        "max_individual_file_bytes": {"type": "integer", "minimum": 1024, "maximum": 52428800},
        "max_total_package_bytes": {"type": "integer", "minimum": 8192, "maximum": 262144000}
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_profile_id",
        "artifact_kind",
        "display_name",
        "version",
        "template_filename",
        "template_sha256",
        "permitted_output_extensions",
        "required_slots",
        "optional_slots",
        "locale",
        "accessibility",
        "lifecycle_state",
        "environment",
        "owner",
        "logical_location"
      ],
      "properties": {
        "template_profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "artifact_kind": {"const": "word"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"},
        "template_filename": {"type": "string", "pattern": "^[^/\\\\]{1,120}[.](dotx|docx)$"},
        "template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "permitted_output_extensions": {"const": [".docx"]},
        "required_slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}
        },
        "optional_slots": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}
        },
        "locale": {"const": "en-GB"},
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["require_heading_structure", "require_table_headers", "require_figure_alt_text"],
          "properties": {
            "require_heading_structure": {"const": true},
            "require_table_headers": {"const": true},
            "require_figure_alt_text": {"const": true}
          }
        },
        "lifecycle_state": {"enum": ["draft", "approved", "retired"]},
        "environment": {"enum": ["synthetic-test", "production"]},
        "owner": {"type": "string", "minLength": 1, "maxLength": 120},
        "logical_location": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}
