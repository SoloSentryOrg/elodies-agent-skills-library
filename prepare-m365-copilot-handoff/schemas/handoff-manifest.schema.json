{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.solosentry.example/m365-handoff/v1/handoff-manifest.schema.json",
  "title": "Immutable Microsoft 365 handoff manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "package_id",
    "content_digest",
    "created_at",
    "producer",
    "environment",
    "classification",
    "locale",
    "request_summary",
    "destination",
    "trusted_instructions",
    "artifacts",
    "files",
    "sources",
    "validation"
  ],
  "properties": {
    "$schema": {"const": "https://schemas.solosentry.example/m365-handoff/v1/handoff-manifest.schema.json"},
    "schema_version": {"const": "1.0"},
    "package_id": {"type": "string", "pattern": "^m365h-[0-9a-f]{20}$"},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "prepare-m365-copilot-handoff"},
        "version": {"const": "1.0.0"}
      }
    },
    "environment": {"enum": ["synthetic-test", "production"]},
    "classification": {"const": "internal"},
    "locale": {"const": "en-GB"},
    "request_summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "logical_location"],
      "properties": {
        "kind": {"enum": ["sharepoint", "onedrive"]},
        "logical_location": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}
      }
    },
    "trusted_instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "require_human_approval_before_replace", "allow_external_publication", "allow_macros"],
      "properties": {
        "operation": {"const": "create"},
        "require_human_approval_before_replace": {"const": true},
        "allow_external_publication": {"const": false},
        "allow_macros": {"const": false}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "operation", "payload", "preview", "output_filename", "template", "required_slots", "acceptance_profile"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "kind": {"const": "word"},
          "operation": {"const": "create"},
          "payload": {"type": "string", "pattern": "^payloads/[a-z0-9][a-z0-9-]{2,63}[.]word[.]json$"},
          "preview": {"type": "string", "pattern": "^previews/[a-z0-9][a-z0-9-]{2,63}[.]md$"},
          "output_filename": {"type": "string", "pattern": "^[^/\\\\]+[.]docx$"},
          "template": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile_id", "version", "sha256"],
            "properties": {
              "profile_id": {"type": "string"},
              "version": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "required_slots": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}},
          "acceptance_profile": {"const": "office-desktop"}
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 5,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "bytes", "sha256", "purpose", "identity_included", "security_scan"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "media_type": {"enum": ["application/json", "text/markdown"]},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "purpose": {"enum": ["word-payload", "preview", "source-register", "human-handoff", "validation-evidence"]},
          "identity_included": {"type": "boolean"},
          "source_id": {"type": "string"},
          "security_scan": {"const": "pass"}
        }
      }
    },
    "sources": {"type": "array", "maxItems": 256, "items": {"type": "object"}},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "json_report", "text_report"],
      "properties": {
        "status": {"const": "pass"},
        "json_report": {"const": "evidence/validation-report.json"},
        "text_report": {"const": "evidence/validation-report.txt"}
      }
    }
  }
}
