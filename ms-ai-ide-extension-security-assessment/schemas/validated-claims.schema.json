{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/ms-ai-ide-extension-security-assessment/validated-claims-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment", "target", "version", "analyst_validation", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "assessment": {"type": "string", "minLength": 1, "maxLength": 512},
    "target": {"type": "string", "minLength": 1, "maxLength": 512},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "analyst_validation": {"enum": ["Incomplete", "Validated"]},
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "value", "evidence_ids", "source_stages", "evidence_state", "confidence", "limitations"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
          "type": {"const": "text"},
          "value": {"type": "string", "minLength": 1, "maxLength": 65536},
          "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[A-Z0-9-]{3,64}$"}},
          "source_stages": {"type": "array", "minItems": 1, "maxItems": 15, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 15}},
          "evidence_state": {"enum": ["Verified", "Inferred", "Not observed", "Not applicable", "Unknown", "Blocked"]},
          "confidence": {"type": "string", "minLength": 1, "maxLength": 256},
          "limitations": {"type": "string", "maxLength": 16384}
        }
      }
    }
  }
}
