{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/ms-ai-ide-extension-security-assessment/report-model-v2.json",
  "title": "Authoritative assessment report model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment", "target", "publisher", "extension_id", "version", "run_key", "assessment_date", "document_version", "classification", "decision", "overall_residual_risk", "review_trigger", "ide_scope", "executive_outcomes", "approval_conditions", "sections", "findings", "evidence", "references", "glossary", "figure", "derivative_sources"],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "^[^\\u0000]+$"},
    "sourceIds": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:EVD-[A-Z0-9-]{3,64}|REF-\\d{3})$"}},
    "table": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "columns", "rows"],
      "properties": {
        "title": {"$ref": "#/$defs/text"},
        "columns": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/text"}},
        "rows": {"type": "array", "minItems": 1, "maxItems": 250, "items": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/text"}}}
      },
      "oneOf": [
        {"properties": {"columns": {"minItems": 1, "maxItems": 1}, "rows": {"items": {"minItems": 1, "maxItems": 1}}}},
        {"properties": {"columns": {"minItems": 2, "maxItems": 2}, "rows": {"items": {"minItems": 2, "maxItems": 2}}}},
        {"properties": {"columns": {"minItems": 3, "maxItems": 3}, "rows": {"items": {"minItems": 3, "maxItems": 3}}}},
        {"properties": {"columns": {"minItems": 4, "maxItems": 4}, "rows": {"items": {"minItems": 4, "maxItems": 4}}}},
        {"properties": {"columns": {"minItems": 5, "maxItems": 5}, "rows": {"items": {"minItems": 5, "maxItems": 5}}}},
        {"properties": {"columns": {"minItems": 6, "maxItems": 6}, "rows": {"items": {"minItems": 6, "maxItems": 6}}}},
        {"properties": {"columns": {"minItems": 7, "maxItems": 7}, "rows": {"items": {"minItems": 7, "maxItems": 7}}}},
        {"properties": {"columns": {"minItems": 8, "maxItems": 8}, "rows": {"items": {"minItems": 8, "maxItems": 8}}}},
        {"properties": {"columns": {"minItems": 9, "maxItems": 9}, "rows": {"items": {"minItems": 9, "maxItems": 9}}}},
        {"properties": {"columns": {"minItems": 10, "maxItems": 10}, "rows": {"items": {"minItems": 10, "maxItems": 10}}}},
        {"properties": {"columns": {"minItems": 11, "maxItems": 11}, "rows": {"items": {"minItems": 11, "maxItems": 11}}}},
        {"properties": {"columns": {"minItems": 12, "maxItems": 12}, "rows": {"items": {"minItems": 12, "maxItems": 12}}}}
      ]
    },
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "heading", "level", "paragraphs", "bullets", "tables"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
        "heading": {"$ref": "#/$defs/text"},
        "level": {"enum": [1, 2, 3]},
        "paragraphs": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/text"}},
        "bullets": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/text"}},
        "tables": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/table"}}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "scope", "scenario", "evidence_ids", "likelihood", "impact", "inherent", "controls", "control_strength", "residual_likelihood", "residual_impact", "residual", "recommendation", "owner", "priority", "target_date", "verification", "mappings", "confidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^(?:F|RISK)-[0-9]{3}$"},
        "title": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/text"}, "scenario": {"$ref": "#/$defs/text"}, "evidence_ids": {"$ref": "#/$defs/text"}, "likelihood": {"$ref": "#/$defs/text"}, "impact": {"$ref": "#/$defs/text"}, "inherent": {"$ref": "#/$defs/text"}, "controls": {"$ref": "#/$defs/text"}, "control_strength": {"$ref": "#/$defs/text"}, "residual_likelihood": {"$ref": "#/$defs/text"}, "residual_impact": {"$ref": "#/$defs/text"}, "residual": {"$ref": "#/$defs/text"}, "recommendation": {"$ref": "#/$defs/text"}, "owner": {"$ref": "#/$defs/text"}, "priority": {"$ref": "#/$defs/text"}, "target_date": {"$ref": "#/$defs/text"}, "verification": {"$ref": "#/$defs/text"}, "mappings": {"$ref": "#/$defs/text"}, "confidence": {"$ref": "#/$defs/text"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "source", "method", "state", "limitation"],
      "properties": {"id": {"type": "string", "pattern": "^EVD-[A-Z0-9-]{3,64}$"}, "title": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/text"}, "method": {"$ref": "#/$defs/text"}, "state": {"$ref": "#/$defs/text"}, "limitation": {"$ref": "#/$defs/text"}}
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "publisher", "url", "accessed", "applicability"],
      "properties": {"id": {"type": "string", "pattern": "^REF-\\d{3}$"}, "title": {"$ref": "#/$defs/text"}, "publisher": {"$ref": "#/$defs/text"}, "url": {"type": "string", "pattern": "^https://[^\\s\\u0000]+$", "maxLength": 8192}, "accessed": {"type": "string", "format": "date"}, "applicability": {"$ref": "#/$defs/text"}}
    },
    "glossary": {
      "type": "object", "additionalProperties": false,
      "required": ["term", "definition"],
      "properties": {"term": {"$ref": "#/$defs/text"}, "definition": {"$ref": "#/$defs/text"}}
    },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "date", "status", "change"],
      "properties": {"version": {"type": "string", "pattern": "^\\d+\\.\\d+$"}, "date": {"type": "string", "format": "date"}, "status": {"type": "string", "minLength": 1, "maxLength": 4096}, "change": {"type": "string", "minLength": 1, "maxLength": 4096}}
    },
    "figure": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "alt_text", "nodes", "edges"],
      "properties": {
        "title": {"$ref": "#/$defs/text"}, "alt_text": {"$ref": "#/$defs/text"},
        "nodes": {"type": "array", "minItems": 3, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "edges": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/text"}}}
      }
    },
    "derivativeSources": {
      "type": "object", "additionalProperties": false,
      "required": ["cover", "executive_outcomes", "approval_conditions", "figure", "findings", "decision", "review_trigger"],
      "properties": {
        "cover": {"$ref": "#/$defs/sourceIds"},
        "executive_outcomes": {"type": "array", "minItems": 5, "maxItems": 10, "items": {"$ref": "#/$defs/sourceIds"}},
        "approval_conditions": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/sourceIds"}},
        "figure": {"$ref": "#/$defs/sourceIds"},
        "findings": {"type": "object", "minProperties": 1, "maxProperties": 100, "additionalProperties": {"$ref": "#/$defs/sourceIds"}},
        "decision": {"$ref": "#/$defs/sourceIds"}, "review_trigger": {"$ref": "#/$defs/sourceIds"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 2},
    "assessment": {"$ref": "#/$defs/text"}, "target": {"$ref": "#/$defs/text"}, "publisher": {"$ref": "#/$defs/text"},
    "extension_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "run_key": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-v\\d+\\.\\d+$"},
    "assessment_date": {"type": "string", "format": "date"},
    "document_version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "classification": {"const": "PUBLIC"},
    "decision": {"enum": ["Approve", "Approve with conditions", "Defer pending evidence", "Do not approve"]},
    "overall_residual_risk": {"enum": ["Low", "Moderate", "High", "Critical"]},
    "review_trigger": {"$ref": "#/$defs/text"},
    "ide_scope": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/text"}},
    "executive_outcomes": {"type": "array", "minItems": 5, "maxItems": 10, "items": {"$ref": "#/$defs/text"}},
    "approval_conditions": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/text"}},
    "sections": {"type": "array", "minItems": 20, "maxItems": 100, "items": {"$ref": "#/$defs/section"}},
    "findings": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/finding"}},
    "evidence": {"type": "array", "minItems": 5, "maxItems": 250, "items": {"$ref": "#/$defs/evidence"}},
    "references": {"type": "array", "minItems": 12, "maxItems": 250, "items": {"$ref": "#/$defs/reference"}},
    "glossary": {"type": "array", "minItems": 5, "maxItems": 100, "items": {"$ref": "#/$defs/glossary"}},
    "figure": {"$ref": "#/$defs/figure"},
    "derivative_sources": {"$ref": "#/$defs/derivativeSources"},
    "revision_history": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/revision"}}
  }
}
